# Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=info
# PORT is provided automatically by Railway in production; default for local.
PORT=8000
# API service: api. Worker service: worker. Railway can use the same railway.json/start.sh for both.
CALRY_PROCESS=api

# Sentry error/performance monitoring. Leave unset to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0

# CORS allowed origins — comma-separated, or "*" for all.
# Production: set explicit origins (e.g. https://app.calry.ai) to allow credentials.
ALLOWED_ORIGINS=*

# Public Privacy Policy / Terms pages. Set these to the legal entity operating
# Calry and a monitored inbox before submitting the app to either store.
LEGAL_OPERATOR_NAME=Calry
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=2026-07-13

# Database
# Use postgresql+asyncpg:// for async connections.
# On Railway, reference the Postgres plugin var: DATABASE_URL=${{Postgres.DATABASE_URL}}
# (the app auto-rewrites postgres:// and postgresql:// to the async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calry

# Background jobs
# On Railway, add a Redis service/plugin and set REDIS_URL from its connection URL.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
MEAL_ANALYSIS_MAX_RETRIES=2
MEAL_UPLOAD_MAX_BYTES=20971520
# Keep at 1 on small Railway instances. Raise only after increasing memory.
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
# Celery expects KiB; child is recycled after a task exceeds this RSS.
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=384000

# Media storage
# local = app/static/uploads; s3 = S3-compatible object storage.
# For production photo analysis, uploaded objects must be reachable by the AI
# provider and the mobile app. Use a public-read bucket policy for uploads/*,
# S3_PUBLIC_READ=true, or S3_PUBLIC_URL_BASE/CDN.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
S3_PUBLIC_READ=true

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=calry-62362
# Full Firebase service account JSON. In Railway, paste the full JSON as the variable value.
FIREBASE_CREDENTIALS=

# Admin dashboard. Firebase token is always verified before claim/UID authorization.
ADMIN_FIREBASE_UIDS=uid_1,uid_2
ADMIN_FRONTEND_ORIGIN=http://localhost:3000
ADMIN_SEARCH_RATE_LIMIT_PER_MINUTE=30
ADMIN_PROMO_CODE_RATE_LIMIT_PER_MINUTE=10
ADMIN_DELETION_RATE_LIMIT_PER_MINUTE=5
ADMIN_DELETION_STALE_SECONDS=300
# Long random secret; keep stable or audit pseudonyms will change.
ADMIN_AUDIT_HASH_KEY=
ADMIN_AUDIT_RETENTION_DAYS=365

# RevenueCat
# Shared secret sent by RevenueCat in the webhook Authorization header.
# Required in production (the webhook returns 503 without it).
REVENUECAT_WEBHOOK_SECRET=
# Secret REST API key (sk_...) from RevenueCat → Project → API keys.
# When set, every webhook verifies the real entitlement state via
# GET /subscribers/{app_user_id} instead of trusting the event payload.
REVENUECAT_API_KEY=
# Entitlement identifier configured in the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID=Calry Pro
REVENUECAT_API_TIMEOUT_SECONDS=10.0
REVENUECAT_API_MAX_RETRIES=2

# Free-access promo codes. Generate a stable random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PROMO_CODE_PEPPER=
PROMO_CODE_REDEMPTION_ENABLED=true
PROMO_CODE_MAX_ATTEMPTS=8
PROMO_CODE_ATTEMPT_WINDOW_MINUTES=15

# AI Provider API Keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Selected AI Provider
DEFAULT_AI_PROVIDER=openrouter
AI_PROVIDER=openrouter

# OpenRouter specific models
# Recommended OpenAI-via-OpenRouter options:
# - Best quality: openai/gpt-5.5
# - Best quality/cost for meal scan: openai/gpt-5.4-mini
# - Fastest/cheapest fallback: openai/gpt-5.4-nano
# Keep current Gemini defaults unless OpenRouter account has these OpenAI slugs enabled.
# Audio uses OpenRouter's dedicated speech-to-text endpoint. Its transcript is
# then analyzed by OPENROUTER_TEXT_MODEL, exactly like typed input.
# Revert OPENROUTER_TEXT_MODEL to google/gemini-2.5-flash if an A/B shows accuracy loss.
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Retries and timeouts
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=1
AI_MAX_COMPLETION_TOKENS=900
AI_TEMPERATURE=0.1
AI_REASONING_EFFORT=minimal
AI_EXCLUDE_REASONING=true

# AI pipeline toggles (redesign). Structured output auto-downgrades to json_object
# if a routed model rejects it; image downscale and the food-memory cache are safe defaults.
AI_STRUCTURED_OUTPUT=true
AI_IMAGE_DOWNSCALE=true
AI_IMAGE_MAX_EDGE=1536
AI_IMAGE_JPEG_QUALITY=85
FOOD_MEMORY_CACHE_ENABLED=true
FOOD_MEMORY_FUZZY_ENABLED=true
FOOD_MEMORY_FUZZY_THRESHOLD=92
FOOD_MEMORY_MIN_USE_COUNT=2

# Versioned insights. Source versions, not elapsed time, determine validity.
# Repeated events are coalesced before the next lazy recomputation.
ENABLE_VERSIONED_INSIGHT_SNAPSHOTS=true
INSIGHT_RECOMPUTE_DEBOUNCE_SECONDS=600
# Proactive Insight Engine
ENABLE_PROACTIVE_INSIGHTS=true
PROACTIVE_INSIGHTS_ASYNC_ENABLED=true
PROACTIVE_INSIGHT_MODEL=google/gemini-2.5-flash-lite
PROACTIVE_INSIGHT_MIN_CONFIDENCE=0.72
PROACTIVE_INSIGHT_MIN_SIGNIFICANCE=0.30
PROACTIVE_INSIGHT_MIN_NOVELTY=0.55
PROACTIVE_INSIGHT_MIN_USEFULNESS=0.55
PROACTIVE_INSIGHT_COOLDOWN_DAYS=7
PROACTIVE_INSIGHT_TYPE_COOLDOWNS=daily_calorie_milestone:1,repeated_meal:14
PROACTIVE_INSIGHT_MAX_CANDIDATES_PER_EVENT=4
PROACTIVE_NOTIFICATION_MIN_SCORE=0.62
PROACTIVE_NOTIFICATION_DAILY_LIMIT=1
PROACTIVE_NOTIFICATION_MAX_AGE_HOURS=72
PROACTIVE_NOTIFICATION_RETRY_MAX=3
PROACTIVE_NOTIFICATION_RETRY_BASE_SECONDS=300
PROACTIVE_PUSH_ENABLED=true
