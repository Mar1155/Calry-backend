# Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=info
# PORT is provided automatically by Railway in production; default for local.
PORT=8000
# API service: api. Worker service: worker. Railway can use the same railway.json/start.sh for both.
CALRY_PROCESS=api

# CORS allowed origins — comma-separated, or "*" for all.
# Production: set explicit origins (e.g. https://app.calry.ai) to allow credentials.
ALLOWED_ORIGINS=*

# Database
# Use postgresql+asyncpg:// for async connections.
# On Railway, reference the Postgres plugin var: DATABASE_URL=${{Postgres.DATABASE_URL}}
# (the app auto-rewrites postgres:// and postgresql:// to the async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calry

# Background jobs
# On Railway, add a Redis service/plugin and set REDIS_URL from its connection URL.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
MEAL_ANALYSIS_MAX_RETRIES=2

# Media storage
# local = app/static/uploads; s3 = S3-compatible object storage.
# For production photo analysis, use s3 and make returned URLs reachable by the AI provider
# via bucket policy, S3_PUBLIC_READ=true, or S3_PUBLIC_URL_BASE/CDN.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
S3_PUBLIC_READ=false

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=calry-62362
# Full Firebase service account JSON. In Railway, paste the full JSON as the variable value.
FIREBASE_CREDENTIALS=

# RevenueCat
# Shared secret sent by RevenueCat in the webhook Authorization header.
# Required in production (the webhook returns 503 without it).
REVENUECAT_WEBHOOK_SECRET=
# Secret REST API key (sk_...) from RevenueCat → Project → API keys.
# When set, every webhook verifies the real entitlement state via
# GET /subscribers/{app_user_id} instead of trusting the event payload.
REVENUECAT_API_KEY=
# Entitlement identifier configured in the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID=Calry Pro
REVENUECAT_API_TIMEOUT_SECONDS=10.0
REVENUECAT_API_MAX_RETRIES=2

# AI Provider API Keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Selected AI Provider
DEFAULT_AI_PROVIDER=openrouter
AI_PROVIDER=openrouter

# OpenRouter specific models
# Recommended OpenAI-via-OpenRouter options:
# - Best quality: openai/gpt-5.5
# - Best quality/cost for meal scan: openai/gpt-5.4-mini
# - Fastest/cheapest fallback: openai/gpt-5.4-nano
# Keep current Gemini defaults unless OpenRouter account has these OpenAI slugs enabled.
# C14: text-only estimation runs on the cheaper flash-lite; vision/audio stay on flash.
# Revert OPENROUTER_TEXT_MODEL to google/gemini-2.5-flash if an A/B shows accuracy loss.
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# Retries and timeouts
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=1

# AI pipeline toggles (redesign). Structured output auto-downgrades to json_object
# if a routed model rejects it; image downscale and the food-memory cache are safe defaults.
AI_STRUCTURED_OUTPUT=true
AI_IMAGE_DOWNSCALE=true
AI_IMAGE_MAX_EDGE=1536
AI_IMAGE_JPEG_QUALITY=85
FOOD_MEMORY_CACHE_ENABLED=true
FOOD_MEMORY_FUZZY_ENABLED=true
FOOD_MEMORY_FUZZY_THRESHOLD=92
FOOD_MEMORY_MIN_USE_COUNT=2
